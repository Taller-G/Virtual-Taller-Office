# Public URL of the Colyseus server (ws:// locally, wss:// in production).
# The static client reads it at build time: changing it means rebuilding.
VITE_SERVER_URL=ws://localhost:2567

# Port of Vite's development server (optional)
VITE_PORT=5173

# The maps come from the world registry (packages/shared/src/worlds.ts): each
# world names its file inside public/assets/map/. The tilesets' images are
# resolved relative to that file, as in Tiled.
