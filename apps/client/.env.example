# URL pública del servidor Colyseus (ws:// en local, wss:// en producción).
# El cliente estático la lee en tiempo de build: cambiarla implica rebuild.
VITE_SERVER_URL=ws://localhost:2567

# Puerto del servidor de desarrollo de Vite (opcional)
VITE_PORT=5173

# URL (relativa al sitio o absoluta) del mapa Tiled JSON. Opcional; por defecto
# /assets/map/oficina-taller.json. Las imágenes de los tilesets se resuelven
# relativas a esta URL, como en Tiled.
# VITE_MAP_URL=/assets/map/oficina-taller.json
