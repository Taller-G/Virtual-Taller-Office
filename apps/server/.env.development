# HTTP + WebSocket port of the Colyseus server
PORT=2567

# Maximum number of simultaneous players per world
MAX_CLIENTS=50

# Seconds the server holds the seat of a player whose connection dropped
# without notice (network down) before removing them from the room. Keeping it
# low guarantees everyone else sees the player disappear within seconds.
RECONNECT_GRACE_SECONDS=2

# WebSocket heartbeat: a ping is sent every PING_INTERVAL_MS; after
# PING_MAX_RETRIES without an answer the connection is closed. It defines how
# fast a dropped network is detected.
PING_INTERVAL_MS=2000
PING_MAX_RETRIES=2

# Seconds without moving after which the avatar shows as "away" to everyone
# else. On moving again it goes back to "active".
AWAY_AFTER_SECONDS=300

# Conversation bubbles: radius in px (empty = 2 tiles of the map) and cap of
# people per bubble.
# BUBBLE_RADIUS_PX=64
BUBBLE_MAX_MEMBERS=6
