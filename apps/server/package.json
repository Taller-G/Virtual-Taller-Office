{
  "name": "@vto/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor en tiempo real (Colyseus) de la Oficina Taller",
  "type": "module",
  "engines": {
    "node": ">= 22.0.0"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node build/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.27",
    "@colyseus/tools": "^0.18.3",
    "@colyseus/ws-transport": "^0.18.2",
    "@vto/shared": "*",
    "colyseus": "^0.18.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
