# HTTP + WebSocket port of the Colyseus server
PORT=2567

# Maximum number of simultaneous players per world (First Office, Chiron Office...)
MAX_CLIENTS=50

# Seconds the server holds the seat of a player whose connection dropped
# without notice (network down) before removing them from the room. Keeping it
# low guarantees everyone else sees the player disappear within seconds.
RECONNECT_GRACE_SECONDS=2

# WebSocket heartbeat: a ping is sent every PING_INTERVAL_MS; after
# PING_MAX_RETRIES without an answer the connection is closed. It defines how
# fast a dropped network is detected.
PING_INTERVAL_MS=2000
PING_MAX_RETRIES=2

# The worlds and their maps are declared in packages/shared/src/worlds.ts (one
# entry per world + its file in apps/client/public/assets/map/): client and
# server read the same registry, so there is no environment variable for that.

# Seconds without moving after which the avatar shows as "away" to everyone
# else. On moving again it goes back to "active".
AWAY_AFTER_SECONDS=300

# Radius (px) of a conversation bubble: two players without a bubble who come
# within this radius open one, and whoever moves further than this from the
# centre of theirs leaves it. Empty = 2 tiles of the map (64 px with 32 px
# tiles), the intimate conversation distance.
# BUBBLE_RADIUS_PX=64

# Maximum number of people in a single bubble. A full bubble absorbs nobody
# else: whoever walks up sees the "bubble full" indication.
BUBBLE_MAX_MEMBERS=6

# Bubble chat: cap of messages accepted per player within the window. Past the
# cap, the server rejects with "you are typing too fast" instead of relaying.
# Messages are ephemeral: none of them is stored.
CHAT_MAX_PER_WINDOW=5
CHAT_RATE_WINDOW_MS=2000
