# Puerto HTTP + WebSocket del servidor Colyseus
PORT=2567

# Máximo de jugadores simultáneos por mundo (First Office, Chiron Office…)
MAX_CLIENTS=50

# Segundos que el servidor sostiene el asiento de un jugador cuya conexión se
# cortó sin aviso (red caída) antes de quitarlo de la sala. Mantenerlo bajo
# garantiza que el resto vea desaparecer al jugador en pocos segundos.
RECONNECT_GRACE_SECONDS=2

# Latido WebSocket: cada PING_INTERVAL_MS se hace ping; tras PING_MAX_RETRIES
# sin respuesta se cierra la conexión. Define cuán rápido se detecta una red caída.
PING_INTERVAL_MS=2000
PING_MAX_RETRIES=2

# Los mundos y sus mapas se declaran en packages/shared/src/worlds.ts (una
# entrada por mundo + su archivo en apps/client/public/assets/map/): cliente y
# servidor leen el mismo registro, así que no hay variable de entorno para eso.

# Segundos sin moverse tras los cuales el avatar aparece como "ausente" para
# los demás. Al volver a moverse vuelve a "activo".
AWAY_AFTER_SECONDS=300

# Radio (px) de una burbuja de conversación: dos jugadores sin burbuja que
# quedan a menos de este radio abren una, y quien se aleja más que esto del
# centro de la suya se sale. Vacío = 2 tiles del mapa (64 px con tiles de 32),
# la distancia de conversación íntima.
# BUBBLE_RADIUS_PX=64

# Máximo de personas en una misma burbuja. Una burbuja llena no absorbe a nadie
# más: quien se acerca ve la indicación de "burbuja llena".
BUBBLE_MAX_MEMBERS=6

# Chat de la burbuja: tope de mensajes aceptados por jugador dentro de la
# ventana. Pasado el tope, el servidor rechaza con "escribiste muy rápido" en
# vez de retransmitir. Los mensajes son efímeros: no se guarda ninguno.
CHAT_MAX_PER_WINDOW=5
CHAT_RATE_WINDOW_MS=2000
